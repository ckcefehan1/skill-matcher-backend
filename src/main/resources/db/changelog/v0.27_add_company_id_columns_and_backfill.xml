        </update>
        <update tableName="user_skills">
            <column name="company_id" value="a0000000-0000-4000-8000-000000000002"/>
            <where>company_id IS NULL</where>
        </update>
        <update tableName="user_availability">
            <column name="company_id" value="a0000000-0000-4000-8000-000000000002"/>
            <where>company_id IS NULL</where>
        </update>
        <update tableName="conversations">
