<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <!--
      Step 2 of 3: nullable company_id everywhere, default company, backfill.
      v0.28 turns the tenant-scoped columns NOT NULL and adds FKs/indexes.
    -->
    <!-- Only existing installs get a Default Company: on a fresh install there is
         nothing to backfill, and the standalone initializer creates the company
         from app.standalone.* properties instead. -->
    <changeSet id="1775100000000-1" author="efehan">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT CASE WHEN EXISTS (SELECT 1 FROM users) THEN 1 ELSE 0 END</sqlCheck>
        </preConditions>
        <insert tableName="companies">
            <column name="id" value="a0000000-0000-4000-8000-000000000002"/>
            <column name="name" value="Default Company"/>
            <column name="street" value="Unknown"/>
            <column name="zip" value="00000"/>
            <column name="city" value="Unknown"/>
            <column name="country" value="DE"/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
    </changeSet>
    <changeSet id="1775100000000-2" author="efehan">
        <addColumn tableName="users">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="projects">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="project_members">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="project_skills">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="project_applications">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="user_skills">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="user_availability">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="conversations">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="chat_messages">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="notifications">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="invitation_tokens">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1775100000000-3" author="efehan">
        <!-- root contexts: rows without a tenant stay NULL on purpose.
             refresh_tokens / password_reset_tokens get no column at all — no entity maps it. -->
        <addColumn tableName="audit_logs">
            <column name="company_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1775100000000-4" author="efehan">
        <update tableName="users">
            <column name="company_id" value="a0000000-0000-4000-8000-000000000002"/>
            <where>company_id IS NULL</where>
        </update>
        <update tableName="projects">
            <column name="company_id" value="a0000000-0000-4000-8000-000000000002"/>
            <where>company_id IS NULL</where>
        </update>
        <update tableName="project_members">
            <column name="company_id" value="a0000000-0000-4000-8000-000000000002"/>
            <where>company_id IS NULL</where>
        </update>
        <update tableName="project_skills">
            <column name="company_id" value="a0000000-0000-4000-8000-000000000002"/>
            <where>company_id IS NULL</where>
        </update>
        <update tableName="project_applications">
